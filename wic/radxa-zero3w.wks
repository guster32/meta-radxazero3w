# short-description: Create SD card image with a boot partition
# long-description:
# Create an image that can be written onto a SD card using dd for use
# with Radxa Zero3w style boards .
# It uses SPL, and u-boot
#
# The disk layout used is:
#  -------------------------------------------
# | Area Name | From (sector #)| To (Sector #)|
# |-------------------------------------------|
# | Stage 1    |  64            | 8191         |
# | Stage 2    |  8192          | 12287        |
# | BOOT       |  12288         | 143359       |
# | rootfs     |  143360        | -            |
#  -------------------------------------------
#

# Bootloader with GPT partition table
bootloader --ptable gpt

# Multi-stage bootloader approach
# Stage 1: idbloader.img (SPL + TPL) - starts at sector 64 (32KB offset)
part --source rawcopy --sourceparams="file=idbloader.img" --offset 32 --fixed-size 4M --no-table

# Stage 2: u-boot.itb (U-Boot FIT image) - starts at sector 16384 (8MB offset) - HARDWARE REQUIRED
part --source rawcopy --sourceparams="file=u-boot.itb" --offset 8192 --fixed-size 2M --no-table

# BOOT Partition - starts at sector 20544 (10MB offset) - can be optimized
part --source bootimg-partition --ondisk mmcblk --fstype=ext2 --label boot --active --offset 10272 --fixed-size 64M

# rootfs Partition - minimize gap after BOOT partition
part --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs --align 1024
