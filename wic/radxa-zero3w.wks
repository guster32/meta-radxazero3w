# short-description: Create SD card image with a boot partition
# long-description:
# Create an image that can be written onto a SD card using dd for use
# with Radxa Zero3w style boards .
# It uses SPL, and u-boot
#
# The disk layout used is:
#  -------------------------------------------
# | Area Name | From (sector #)| To (Sector #)|
# |-------------------------------------------|
# | SPL	      |  64	           | 1077         |
# | U-Boot	  |  2048	       | 6143         |
# | BOOT	  |  6144	       | 530431       |
# | rootfs	  |  530432	       | -            |
#  -------------------------------------------
#

# Bootloader with GPT partition table
bootloader --ptable gpt

# SPL (Secondary Program Loader)
part --source rawcopy --sourceparams="file=u-boot-rockchip.bin" --offset 32 --fixed-size 10M --no-table

# U-Boot FIT image without SPL
part --source rawcopy --sourceparams="file=uboot.img" --offset 24576 --no-table

# BOOT Partition
part --source bootimg-partition --ondisk mmcblk --fstype=ext2 --label boot --active --align 2048 --fixed-size 64M

# rootfs Partition
part --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs --align 2048