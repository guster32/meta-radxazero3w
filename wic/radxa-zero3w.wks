# short-description: Create SD card image with a boot partition
# long-description:
# Create an image for Radxa Zero3W style boards using
# Rockchip's modern boot flow (idbloader + u-boot.itb).
#
# The disk layout used is:
#  -------------------------------------------
# | Area Name  | From (sector #) | To (Sector #) |
# |--------------------------------------------|
# | idbloader  | 64              | 8191         |  (32KB offset, ~4MB max)
# | u-boot.itb | 24576           | ~            |  (12MB offset, ~4MB size)
# | BOOT       | 65536           | 196607       |
# | rootfs     | 196608          | -            |
#  -------------------------------------------
#

# Bootloader with GPT partition table
bootloader --ptable gpt

# SPL+TPL (idbloader) at sector 64 (32KB offset)
part --source rawcopy --sourceparams="file=idbloader-sd.img" --offset 32 --fixed-size 4096K --no-table

# U-Boot proper (FIT image) at sector 24576 (12MB offset)
part --source rawcopy --sourceparams="file=u-boot.itb" --offset 12288 --fixed-size 4096K --no-table

# BOOT partition (kernel, dtbs, extlinux.conf, etc.)
part --source bootimg-partition --ondisk mmcblk --fstype=ext2 --label boot --active --offset 32768 --fixed-size 64M

# Root filesystem
part --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs --align 2048
