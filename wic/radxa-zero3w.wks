bootloader --ptable msdos

# SPL (64 to 1077, ~32 KB)
part --source rawcopy --sourceparams="file=u-boot-rockchip.bin" --align 32 --no-table

# U-Boot (2048 to 6143, ~2 MB)
part --source rawcopy --sourceparams="file=uboot.img" --align 1024 --no-table

# BOOT partition (64 MiB)
part --source bootimg-partition \
     --ondisk mmcblk \
     --fstype=ext2 \
     --label boot \
     --active \
     --align 8192 \
     --size=131072

# ROOTFS partition (512 MiB)
part --source rootfs \
     --ondisk mmcblk \
     --fstype=ext4 \
     --label rootfs \
     --align 8192 \
     --size=1048576
